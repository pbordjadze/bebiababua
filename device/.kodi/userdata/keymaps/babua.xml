<?xml version="1.0" encoding="UTF-8"?>
<!--
  babua: make the Samsung remote (via HDMI-CEC) behave like a plain TV remote.

  Watching (FullscreenLiveTV):
    up / down / CH+ / CH-   next / previous channel, immediately
    OK, left, right, BACK   channel list overlay (OK there switches, BACK closes)
    digits                  jump to channel number (Kodi default)
    stop, pause, menu       ignored - a frozen or vanished picture looks "broken"
  Message clip from `babua show` (FullscreenVideo):
    BACK / OK               end it; the channel comes back
  Channel list window (TVChannels) and Home:
    BACK never leaves the TV screens, so she cannot get lost in menus.
  Everywhere: the colour, guide, power, record, teletext, subtitle and library
    keys do nothing. Kodi's defaults would open Videos (green), Music (yellow),
    Pictures (blue), the TV guide or the shutdown menu, if her TV passes them.
    They're repeated in each window because window defaults (FullscreenLiveTV
    falls back to Kodi's FullscreenVideo map) win over <global>.

  Each window is defined for both <remote> (CEC arrives as remote buttons) and
  <keyboard> (USB keyboard / testing).
-->
<keymap>
  <global>
    <remote>
      <menu>noop</menu>
      <title>noop</title>
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
  </global>

  <FullscreenLiveTV>
    <remote>
      <up>ChannelUp</up>
      <down>ChannelDown</down>
      <pageplus>ChannelUp</pageplus>
      <pageminus>ChannelDown</pageminus>
      <select>ActivateWindow(PVROSDChannels)</select>
      <left>ActivateWindow(PVROSDChannels)</left>
      <right>ActivateWindow(PVROSDChannels)</right>
      <back>ActivateWindow(PVROSDChannels)</back>
      <stop>noop</stop>
      <pause>noop</pause>
      <play>noop</play>
      <forward>noop</forward>
      <reverse>noop</reverse>
      <menu>noop</menu>
      <title>noop</title>
      <contentsmenu>noop</contentsmenu>
      <rootmenu>noop</rootmenu>
      <!-- inherited Kodi defaults would leave the TV screens -->
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
    <keyboard>
      <up>ChannelUp</up>
      <down>ChannelDown</down>
      <return>ActivateWindow(PVROSDChannels)</return>
      <enter>ActivateWindow(PVROSDChannels)</enter>
      <left>ActivateWindow(PVROSDChannels)</left>
      <right>ActivateWindow(PVROSDChannels)</right>
      <backspace>ActivateWindow(PVROSDChannels)</backspace>
      <escape>ActivateWindow(PVROSDChannels)</escape>
      <space>noop</space>
      <x>noop</x>
      <c>noop</c>
    </keyboard>
  </FullscreenLiveTV>

  <!-- a clip sent with `babua show`: BACK/OK end it, babuad brings the channel back -->
  <FullscreenVideo>
    <remote>
      <back>Stop</back>
      <select>Stop</select>
      <menu>noop</menu>
      <title>noop</title>
      <!-- inherited Kodi defaults would leave the TV screens -->
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
    <keyboard>
      <backspace>Stop</backspace>
      <escape>Stop</escape>
      <return>Stop</return>
    </keyboard>
  </FullscreenVideo>

  <PVROSDChannels>
    <remote>
      <menu>noop</menu>
      <title>noop</title>
      <!-- inherited Kodi defaults would leave the TV screens -->
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
    <keyboard>
      <c>noop</c>
    </keyboard>
  </PVROSDChannels>

  <TVChannels>
    <remote>
      <back>FullScreen</back>
      <menu>noop</menu>
      <title>noop</title>
      <contentsmenu>noop</contentsmenu>
      <rootmenu>noop</rootmenu>
      <!-- inherited Kodi defaults would leave the TV screens -->
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
    <keyboard>
      <backspace>FullScreen</backspace>
      <escape>FullScreen</escape>
      <c>noop</c>
    </keyboard>
  </TVChannels>

  <Home>
    <remote>
      <back>ActivateWindow(TVChannels)</back>
      <!-- inherited Kodi defaults would leave the TV screens -->
      <menu>noop</menu>
      <title>noop</title>
      <red>noop</red>
      <green>noop</green>
      <yellow>noop</yellow>
      <blue>noop</blue>
      <guide>noop</guide>
      <epgsearch>noop</epgsearch>
      <livetv>noop</livetv>
      <liveradio>noop</liveradio>
      <recordedtv>noop</recordedtv>
      <record>noop</record>
      <myvideo>noop</myvideo>
      <mymusic>noop</mymusic>
      <mypictures>noop</mypictures>
      <mytv>noop</mytv>
      <power>noop</power>
      <teletext>noop</teletext>
      <subtitle>noop</subtitle>
      <language>noop</language>
      <playlist>noop</playlist>
    </remote>
    <keyboard>
      <backspace>ActivateWindow(TVChannels)</backspace>
      <escape>ActivateWindow(TVChannels)</escape>
    </keyboard>
  </Home>
</keymap>
