#!/usr/bin/env bash
# Admin CLI for the grandparents' TV box. Run from anywhere in the repo.
#
#   babua init                    create site/ and generate keys (safe to re-run)
#   babua check                   validate config/ and site/
#   babua preview                 show which provider channels match channels.toml
#   babua codecs                  ffprobe each matched stream: can a Pi 3 play it?
#   babua list-source NAME [-g X] list channel names in a playlist source
#   babua image                   build the flashable image (build/out/)
#
#   babua deploy                  push config/ + device/ + site/ to the box and apply
#   babua ssh [cmd...]            shell on the box (pinned host key, over the VPN)
#   babua status | health         what's playing, health checks
#   babua logs [unit] [-f]        journal (default: all babua units + kodi)
#   babua kodi-log                last 200 lines of kodi.log
#   babua screenshot [file]       grab what grandma sees -> local PNG
#   babua key up|down|select|back|...   press remote buttons
#   babua play N | say TEXT       switch channel / show a message on the TV
#   babua show FILE|URL [SECS]    play a clip/photo on the TV, then back to the channel
#   babua playlist | check-streams
#   babua restart-kodi | reboot [--force] | update VERSION | edid
#
# Host: BABUA_HOST from site/secrets.env (override: BABUA_HOST=... babua ...)
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SITE="${BABUA_SITE:-$REPO/site}"
REMOTE_BIN=/storage/.config/babua/bin

die() { echo "error: $*" >&2; exit 1; }

site_value() {
  [ -f "$SITE/secrets.env" ] || die "no $SITE/secrets.env - run: tools/babua init"
  sed -n "s/^$1=//p" "$SITE/secrets.env" | tail -n1
}

remote() {
  local host="${BABUA_HOST:-$(site_value BABUA_HOST)}"
  [ -n "$host" ] || die "BABUA_HOST not set in site/secrets.env"
  [ -f "$SITE/ssh_host_ed25519_key.pub" ] || die "no pinned host key - run: tools/babua init"
  # Pin the host key generated by `init` (baked into the image): no trust-on-first-use.
  echo "$host $(cut -d' ' -f1,2 "$SITE/ssh_host_ed25519_key.pub")" > "$SITE/known_hosts"
  ssh -o UserKnownHostsFile="$SITE/known_hosts" -o StrictHostKeyChecking=yes \
      -o ConnectTimeout=15 -o ServerAliveInterval=15 -o LogLevel=ERROR \
      "root@$host" "$@"
}

# quote arguments for the remote (busybox) shell
squote() {
  local out="" a
  for a in "$@"; do out+="'${a//\'/\'\\\'\'}' "; done
  printf '%s' "$out"
}

python_ok() {
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null \
    || python3 -c 'import tomli' 2>/dev/null \
    || die "need Python >= 3.11 (or 'pip install tomli')"
}

playlist_local() {
  python_ok
  BABUA_STATE_DIR="$(mktemp -d)" python3 "$REPO/device/.config/babua/bin/playlist.py" \
    --config "$REPO/config" --secrets "$SITE/secrets.env" "$@"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)
    python3 "$REPO/tools/site_init.py" ;;
  check)
    python_ok; python3 "$REPO/tools/stage.py" --site "$SITE" --check ;;
  preview)
    playlist_local --preview ;;
  codecs)
    playlist_local --codecs ;;
  list-source)
    [ $# -ge 1 ] || die "usage: babua list-source SOURCE [-g TEXT]"
    src="$1"; shift; playlist_local --list "$src" "$@" ;;
  image)
    python_ok
    python3 "$REPO/tools/stage.py" --site "$SITE" --check
    if [ "$(uname -s)" = Linux ] && command -v mke2fs >/dev/null && { [ "$(id -u)" = 0 ] || command -v fakeroot >/dev/null; }; then
      python3 "$REPO/tools/build_image.py" --site "$SITE"
    else
      command -v docker >/dev/null || die "need Linux with e2fsprogs+fakeroot, or Docker"
      docker build -q -t babua-builder -f "$REPO/tools/Dockerfile" "$REPO/tools" >/dev/null
      docker run --rm --user "$(id -u):$(id -g)" -v "$REPO:/repo" -v "$SITE:/site:ro" babua-builder \
        python3 /repo/tools/build_image.py --site /site --out /repo/build/out
    fi ;;
  deploy)
    python_ok
    python3 "$REPO/tools/stage.py" --site "$SITE" --check
    python3 "$REPO/tools/stage.py" --site "$SITE" --tar --update | remote \
      "old=\$(sha256sum /storage/.config/wireguard/babua.config 2>/dev/null | cut -c1-64); \
       tar -xzf - -C /storage && python3 $REMOTE_BIN/babua post-deploy \"\$old\"" ;;
  ssh)
    remote "$@" ;;
  logs)
    unit="${1:-}"; shift || true
    if [ -z "$unit" ]; then
      remote "journalctl -b --no-pager -n 300 $* -u kodi -u 'babua*'"
    else
      remote "journalctl -b --no-pager -n 300 $* -u $unit"
    fi ;;
  kodi-log)
    remote "tail -n 200 /storage/.kodi/temp/kodi.log" ;;
  screenshot)
    out="${1:-babua-$(date +%Y%m%d-%H%M%S).png}"
    path="$(remote "python3 $REMOTE_BIN/babua screenshot")"
    remote "cat '$path' && rm -f '$path'" > "$out"
    echo "$out" ;;
  show)
    # Photos become a short H.264 clip, videos are re-encoded unless already
    # Pi-friendly, URLs (e.g. a Jellyfin stream) are played directly.
    [ $# -ge 1 ] || die "usage: babua show FILE|URL [seconds-for-photos] [--force]"
    src="$1"; shift
    force=""; secs=20
    for a in "$@"; do case "$a" in --force) force=--force ;; *) secs="$a" ;; esac; done
    case "$src" in
      *://*) remote "python3 $REMOTE_BIN/babua show $(squote "$src") $force"; exit $? ;;
    esac
    [ -f "$src" ] || die "no such file: $src"
    command -v ffmpeg >/dev/null || die "need ffmpeg for local files"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    fit="scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,format=yuv420p"
    case "$(printf '%s' "$src" | tr 'A-Z' 'a-z')" in
      *.jpg|*.jpeg|*.png|*.webp|*.gif|*.bmp)
        ffmpeg -v error -loop 1 -i "$src" -f lavfi -i anullsrc=r=48000:cl=stereo -t "$secs" \
          -vf "$fit" -r 25 -c:v libx264 -preset veryfast -tune stillimage -c:a aac -shortest "$tmp/show.mp4" ;;
      *)
        vcodec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,height -of csv=p=0 "$src" || true)"
        case "$vcodec" in
          h264,*) h="${vcodec#h264,}"; [ "${h:-9999}" -le 1080 ] && cp "$src" "$tmp/show.mp4" ;;
        esac
        [ -f "$tmp/show.mp4" ] || ffmpeg -v error -i "$src" -vf "scale=-2:'min(720,ih)',format=yuv420p" \
          -c:v libx264 -preset veryfast -crf 23 -c:a aac -b:a 160k -movflags +faststart "$tmp/show.mp4" ;;
    esac
    echo "uploading $(du -h "$tmp/show.mp4" | cut -f1)..."
    remote "mkdir -p /storage/babua-media && rm -f /storage/babua-media/* && cat > /storage/babua-media/show.mp4" < "$tmp/show.mp4"
    remote "python3 $REMOTE_BIN/babua show /storage/babua-media/show.mp4 $force" ;;
  edid)
    # Saves the TV's EDID so the Pi outputs the right picture even if it boots
    # while the TV is off or on another input. Run once with the TV ON.
    remote "getedid create" ;;
  status|health|playlist|check-streams|play|key|say|notify-test|vpn|update|reboot|restart-kodi)
    remote "python3 $REMOTE_BIN/babua $cmd $(squote "$@")" ;;
  help|-h|--help)
    sed -n '2,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *)
    die "unknown command '$cmd' (try: babua help)" ;;
esac
