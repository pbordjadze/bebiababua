# Site-specific values and credentials. `tools/babua init` copies this
# directory to site/ (git-ignored) and fills in the generated keys.
# Never commit site/. The built image contains these values too.

# ---------------------------------------------------------------- IPTV
# Provider playlist URL (M3U / "m3u_plus" / Xtream "get.php?..."). Usually
# contains the username and password - that's why it lives here.
IPTV_M3U_URL=
# Optional XMLTV programme guide; leave empty to use the playlist's url-tvg.
IPTV_EPG_URL=
IPTV_EPG_SHIFT_HOURS=0
# Some providers only answer to a specific player User-Agent.
IPTV_USER_AGENT=
# 1 = play HLS through inputstream.adaptive instead of ffmpeg (try if
# streams stutter or fail to start; see docs/VERIFY.md)
IPTV_USE_ADAPTIVE_HLS=0

# ------------------------------------------------------------- Network
# Ethernet is strongly preferred (and needs nothing here). For Wi-Fi only:
WIFI_SSID=
WIFI_PSK=
# optional second network the box also knows, e.g. your phone's hotspot as
# an on-site fallback if the main Wi-Fi details turn out to be wrong
WIFI_BACKUP_SSID=
WIFI_BACKUP_PSK=

# ----------------------------------------------------------- Tailscale
# Remote admin. Auth key from https://login.tailscale.com/admin/settings/keys
# (one-off, pre-approved). With it set, the box joins your tailnet by itself
# ~3 min after first boot; without it run `babua tailscale-up <key>` on site.
# Afterwards disable key expiry for the machine in the admin console.
TAILSCALE_AUTHKEY=

# Address tools/babua uses for SSH: the MagicDNS name (or 100.x IP).
BABUA_HOST=babua-tv

# ----------------------------------------------- WireGuard (alternative)
# Only if you'd rather use your own WireGuard server than Tailscale.
# The box dials out to the homelab; nothing is opened on grandma's router.
# Endpoint may be a DNS name (re-resolved by connman if your IP changes).
WG_ENDPOINT=
WG_ENDPOINT_PORT=51820
# The box's address inside the tunnel, with prefix
WG_ADDRESS=10.66.66.20/24
# Only these networks go through the tunnel (split tunnel - IPTV stays direct)
WG_ALLOWED_IPS=10.66.66.0/24
WG_SERVER_PUBLIC_KEY=
# generated by `tools/babua init`:
WG_PRIVATE_KEY=
WG_PRESHARED_KEY=

# -------------------------------------------------------- Monitoring
# ntfy topic URL. Prefer a URL reachable from the internet (not only via the
# VPN), otherwise "VPN down" alerts can't arrive until the VPN is back.
NTFY_URL=https://ntfy.example.org/babua-tv
NTFY_TOKEN=
# Optional dead-man switch pinged every 5 min, e.g. an Uptime Kuma push URL
# (https://kuma.example.org/api/push/XXXX?status={status}&msg={msg})
# or https://hc-ping.com/<uuid>. This is how you learn the box is offline.
HEARTBEAT_URL=

# -------------------------------------------------------------- Kodi
# Password for Kodi's web interface / JSON-RPC on :8080 (user "kodi"), used by
# the Kore/Yatse remote apps over the VPN. Generated by `tools/babua init`.
KODI_WEB_PASSWORD=
